# =====================================================================
# SLMForge configuration
# Copy to `.env` and fill in. Never commit `.env`.
# =====================================================================

# --- Core ---
SLMFORGE_ENV=local                       # local | dev | prod
SLMFORGE_HOST=127.0.0.1
SLMFORGE_PORT=8000
SLMFORGE_LOG_LEVEL=INFO
# SQLite for the prototype. Point at Postgres later if needed.
SLMFORGE_DATABASE_URL=sqlite:///./.data/slmforge.db
# Where datasets, checkpoints, logs and reports are written.
SLMFORGE_ARTIFACT_ROOT=./artifacts
SLMFORGE_UPLOAD_ROOT=./uploads

# --- Planner LLM (powers the analyzer/planner; NOT the model we train) ---
# Any OpenAI-compatible endpoint works, including a local Ollama server.
SLMFORGE_LLM_PROVIDER=ollama             # ollama | openai | anthropic | none
SLMFORGE_LLM_BASE_URL=http://127.0.0.1:11434/v1
SLMFORGE_LLM_MODEL=llama3.1:8b
SLMFORGE_LLM_API_KEY=

# --- Model sources ---
SLMFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: raise HF rate limits and unlock private repos.
HF_TOKEN=
# Where huggingface_hub caches downloaded models (keep off a small system drive).
HF_HOME=./.cache/huggingface

# --- Sandbox ---
SLMFORGE_SANDBOX_BACKEND=subprocess       # subprocess | docker
SLMFORGE_SANDBOX_IMAGE=slmforge/sandbox:latest
SLMFORGE_SANDBOX_CPU_LIMIT=8
SLMFORGE_SANDBOX_MEM_LIMIT_MB=16384
SLMFORGE_SANDBOX_TIMEOUT_S=7200
SLMFORGE_SANDBOX_NETWORK=deny             # deny | allowlist | allow

# --- Training defaults (overridable per build) ---
SLMFORGE_MAX_TRAIN_MINUTES=60
SLMFORGE_MAX_VRAM_GB=8
SLMFORGE_DEFAULT_METHOD=qlora
SLMFORGE_SEED=42

# --- Deployment ---
# Publish fine-tuned adapters/models to the HF Hub and/or create an Inference Endpoint.
SLMFORGE_HF_PUSH_ENABLED=false
SLMFORGE_HF_ORG=
SLMFORGE_DEPLOY_TARGET=hf_endpoint        # hf_endpoint | hf_space | local_openai
SLMFORGE_DEPLOY_REQUIRE_APPROVAL=true
